{
  "manifest_version": 3,
  "name": "Gaijin Purchase Parser",
  "version": "4.0",
  "permissions": [
    "webRequest",
    "cookies"
  ],
  "host_permissions": [
    "https://store.gaijin.net/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html"
  }
}