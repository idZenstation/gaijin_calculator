{
  "manifest_version": 3,
  "name": "Gaijin Store Calculator (API)",
  "version": "2.0",
  "permissions": [
    "activeTab",
    "scripting",
    "webRequest",
    "cookies"
  ],
  "host_permissions": [
    "https://store.gaijin.net/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": "icon.png"
  }
}