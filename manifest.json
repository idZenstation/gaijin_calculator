{
  "manifest_version": 3,
  "name": "Gaijin Purchase Parser",
  "version": "3.0",
  "description": "Анализирует историю покупок из popup-блоков",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": "icons/icon48.png"
  },
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "https://store.gaijin.net/*"
  ],
  "content_scripts": [{
    "matches": ["https://store.gaijin.net/user.php*"],
    "js": ["content.js"],
    "run_at": "document_idle"
  }]
}