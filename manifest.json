{
  "manifest_version": 3,
  "name": "Gaijin Store Calculator",
  "version": "2.0",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "permissions": [
    "activeTab",
    "scripting",
    "webRequest",
    "cookies"
  ],
  "host_permissions": [
    "https://store.gaijin.net/*"
  ],
  "background": {
    "service_worker": "background.js"
  }
}