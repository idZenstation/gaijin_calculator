{
  "manifest_version": 3,
  "name": "Gaijin Purchase Summary",
  "version": "2.0.0",
  "description": "Unofficial purchase totals for Gaijin and PixStorm, plus your GJN top-ups, buys and sales.",
  "homepage_url": "https://github.com/idZenstation/gaijin_calculator",

  "permissions": ["activeTab", "storage"],

  "host_permissions": [
    "https://trade.gaijin.net/*",
    "https://market-proxy.gaijin.net/*"
  ],

  "background": {
    "service_worker": "background.js"
  },

  "action": {
    "default_popup": "popup.html",
    "default_title": "View purchase statistics",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },

  "content_scripts": [
    {
      "matches": [
        "https://store.gaijin.net/user.php*",
        "https://store.pixstorm.ru/user.php*"
      ],
      "js": ["expand.js"],
      "world": "MAIN",
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://store.gaijin.net/user.php*",
        "https://store.pixstorm.ru/user.php*"
      ],
      "js": ["price.js", "panel.js", "content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://store.gaijin.net/balance_history.php*",
        "https://store.pixstorm.ru/balance_history.php*"
      ],
      "js": ["panel.js", "balance.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://trade.gaijin.net/*"],
      "js": ["market-bridge.js"],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": ["https://trade.gaijin.net/*"],
      "js": ["market-api.js", "market-token.js"],
      "run_at": "document_start"
    }
  ],

  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}