{
  "manifest_version": 3,
  "name": "Gaijin Purchase Summary",
  "version": "1.3.0",
  "description": "Calculate total purchase amounts in Gaijin Store and PixStorm Store - view your spending statistics",
  "homepage_url": "https://github.com/idZenstation/gaijin_calculator",

  "permissions": ["activeTab", "storage"],

  "action": {
    "default_popup": "popup.html",
    "default_title": "View purchase statistics",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },

  "content_scripts": [
    {
      "matches": [
        "https://store.gaijin.net/user.php*",
        "https://store.pixstorm.ru/user.php*"
      ],
      "js": ["expand.js"],
      "world": "MAIN",
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://store.gaijin.net/user.php*",
        "https://store.pixstorm.ru/user.php*"
      ],
      "js": ["price.js", "content.js"],
      "run_at": "document_idle"
    }
  ],

  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}